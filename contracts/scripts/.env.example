# FixYield testnet deployment — secrets & addresses.
#
# Copy to `.env`, fill in real values, and keep it OUT of git
# (`.env*` is gitignored). Keys are 56-char Stellar secret seeds (S...).
# Never commit this file.

# ---- admin / feeder accounts -------------------------------------------
ADMIN_SECRET=S...            # protocol admin: deploys + inits every contract
ADMIN_ADDR=G...              # public address of ADMIN_SECRET
FEEDER_SECRET=S...           # variable-rate reporter (must equal ADMIN for MVP demo)

# ---- network ------------------------------------------------------------
RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ---- assets & oracles ---------------------------------------------------
# USDC Stellar Asset Contract on testnet (SEP-41). Set to your deployed SAC
# or the canonical testnet USDC SAC address.
TOKEN_ADDR=G...
# SEP-40 price feed for USDC (Reflector Pulse on testnet), wrapped by OracleHub.
USDC_FEED_ADDR=G...
USDC_FEED_DECIMALS=7
MAX_STALENESS=3600          # seconds

# ---- protocol params (match contracts/common RATE_SCALE = 1e9) -----------
TERM_SECONDS=2592000        # 30 days
IDLE_RATE=50000000          # 5% = 0.05 * 1e9
SLOPE=500000000             # 50% per full utilization unit
MIN_RATE=10000000           # 1%
MAX_RATE=250000000          # 25%
POOL_IDLE_RATE=20000000     # mock pool: 2% base
POOL_SLOPE=500000000        # mock pool: 50%
MIN_COLLAT_RATIO=1500000000 # 150%
LIQ_THRESHOLD=1100000000    # 110%
PROTOCOL_FEE_BPS=100        # 1%
FUSDC_DECIMALS=7

# ---- hash-pinned stellar CLI --------------------------------------------
# Version tag of the stellar-cli release to install (SDK 25 line).
STELLAR_CLI_TAG=v25.0.0
# Release tarball sha256 for STELLAR_CLI_TAG (fill from the release notes).
STELLAR_CLI_SHA256=

# ---- outputs --------------------------------------------------------------
# Written by deploy-testnet.sh so CI / README can cite verified tx hashes.
DEPLOY_RECORDS=deployments.env